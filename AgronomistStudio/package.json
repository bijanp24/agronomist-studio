{
  "name": "agronomist-studio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "tsc -p ../shared/tsconfig.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "npm@11.16.0",
  "overrides": {
    "@ngrx/signals": {
      "@angular/core": "22.0.0"
    }
  },
  "dependencies": {
    "@angular/cdk": "^22.0.0",
    "@angular/common": "22.0.0",
    "@angular/compiler": "22.0.0",
    "@angular/core": "22.0.0",
    "@angular/forms": "22.0.0",
    "@angular/platform-browser": "22.0.0",
    "@angular/router": "22.0.0",
    "@ngrx/signals": "^21.1.1",
    "maplibre-gl": "^5.24.0",
    "rxjs": "~7.8.0",
    "shared": "file:../shared",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.0.0",
    "@angular/cli": "22.0.0",
    "@angular/compiler-cli": "22.0.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/geojson": "^7946.0.16",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  }
}
